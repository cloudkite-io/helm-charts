        }
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=~\"$service\", span_kind=~\"SPAN_KIND_CLIENT|SPAN_KIND_INTERNAL\", status_code=\"STATUS_CODE_ERROR\"}[5m])) by (service) / sum(rate(traces_spanmetrics_calls_total{service=~\"$service\", span_kind=~\"SPAN_KIND_CLIENT|SPAN_KIND_INTERNAL\"}[5m])) by (service)",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "description": "Error rate of OUTBOUND/INTERNAL dependency calls a service makes (SPAN_KIND_CLIENT and SPAN_KIND_INTERNAL) \u2014 e.g. failed Azure AD token acquisition, Microsoft Graph, downstream HTTP, DB. A high value here does NOT mean the service is returning errors to its callers (see \"Server Error Rate by Service\"); it means one of its dependencies is failing.",
      "title": "Dependency Error Rate by Service (client/internal spans)",
      "type": "timeseries"
    }
