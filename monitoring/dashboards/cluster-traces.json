          "expr": "histogram_quantile(0.95, sum(rate(traces_spanmetrics_latency_bucket{service=~\"$service\"}[5m])) by (le, service, span_name))",
          "legendFormat": "{{service}} - {{span_name}}",
          "refId": "A"
        }
