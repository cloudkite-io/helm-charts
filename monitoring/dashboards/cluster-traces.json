      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=~\"$service\", span_kind=\"SPAN_KIND_SERVER\", status_code=\"STATUS_CODE_ERROR\"}[5m])) by (service) / sum(rate(traces_spanmetrics_calls_total{service=~\"$service\", span_kind=\"SPAN_KIND_SERVER\"}[5m])) by (service)",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "description": "Error rate for inbound requests the service handled (SPAN_KIND_SERVER only). Excludes failures of outbound/internal dependency calls \u2014 see \"Dependency Error Rate by Service\" for those.",
      "title": "Server Error Rate by Service",
      "type": "timeseries"
    },
