      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (service) (rate(traces_spanmetrics_calls_total{service=~\"$service\", http_response_status_code=~\"5..\"}[5m])) or sum by (service) (rate(traces_spanmetrics_calls_total{service=~\"$service\", http_status_code=~\"5..\"}[5m]))",
          "legendFormat": "{{service}} 5xx",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (service) (rate(traces_spanmetrics_calls_total{service=~\"$service\", http_response_status_code=~\"4..\"}[5m])) or sum by (service) (rate(traces_spanmetrics_calls_total{service=~\"$service\", http_status_code=~\"4..\"}[5m]))",
          "legendFormat": "{{service}} 4xx",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (service) (rate(traces_spanmetrics_calls_total{service=~\"$service\", http_response_status_code=~\"2..\"}[5m])) or sum by (service) (rate(traces_spanmetrics_calls_total{service=~\"$service\", http_status_code=~\"2..\"}[5m]))",
          "legendFormat": "{{service}} 2xx",
          "refId": "C"
        }
      ],
      "description": "HTTP response code rate per service. Requires OTel collector spanmetrics processor to include http.response.status_code (or http.status_code) as a dimension. Empty if dimension is not exported.",
      "title": "HTTP Response Code Rate by Service (2xx / 4xx / 5xx)",
      "type": "timeseries"
    },
