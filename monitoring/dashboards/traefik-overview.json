      "id": 43,
      "type": "timeseries",
      "title": "Time Since Last Successful Config Reload",
      "description": "Traefik v3 exposes `traefik_config_last_reload_success` as a unix timestamp gauge, not a failure counter. This plots how stale that timestamp is. It climbs steadily while nothing changes; it should drop to zero on every successful reload. A sawtooth that stops resetting while routes are being changed means Traefik is serving stale config.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
